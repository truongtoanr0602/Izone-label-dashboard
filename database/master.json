    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO izone.classes (class_id, class_name, course_id, teacher_id, status, schedule, opening_date) VALUES ({{$json.class_id}}, '{{$json.class_name}}', {{$json.course_id}}, {{$json.teacher_id}}, '{{$json.status}}', '{{$json.schedule}}', '{{$json.opening_date}}') ON CONFLICT (class_id) DO UPDATE SET class_name=EXCLUDED.class_name, course_id=EXCLUDED.course_id, teacher_id=EXCLUDED.teacher_id, status=EXCLUDED.status, schedule=EXCLUDED.schedule, opening_date=EXCLUDED.opening_date;",
        "options": {}
