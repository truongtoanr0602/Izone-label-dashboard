{
  "name": "Sync Master Data (Teachers, Classes, Students) MySQL -> Postgres",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger-teachers",
      "name": "1. Sync Teachers",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id as teacher_id, full_name as teacher_name, email as teacher_email, phone as teacher_phone FROM users WHERE role = 'teacher' OR role = 'lead';"
      },
      "id": "mysql-teachers",
      "name": "Fetch Teachers (MySQL)",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.2,
      "position": [200, 0],
      "credentials": {
        "mySql": {
          "id": "XnB2SP73qqnEX11Z",
          "name": "SQL_IZONE"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO izone.teachers (teacher_id, teacher_name, teacher_email, teacher_phone) VALUES ({{$json.teacher_id}}, '{{$json.teacher_name}}', '{{$json.teacher_email}}', '{{$json.teacher_phone}}') ON CONFLICT (teacher_id) DO UPDATE SET teacher_name=EXCLUDED.teacher_name, teacher_email=EXCLUDED.teacher_email, teacher_phone=EXCLUDED.teacher_phone;",
        "options": {}
      },
      "id": "postgres-upsert-teachers",
      "name": "Upsert Teachers (Postgres)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [400, 0],
      "credentials": {
        "postgres": {
          "id": "Postgres_IZONE_Prod",
          "name": "Postgres_IZONE_Prod"
        }
      }
    },
    
    {
      "parameters": {},
