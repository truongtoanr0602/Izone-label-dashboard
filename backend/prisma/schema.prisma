  attendance_total        Int?     @default(0)
  homework_pct            Decimal? @db.Decimal(5, 2)
  homework_done           Int?     @default(0)
  homework_total          Int?     @default(0)
  test_1                  Decimal? @db.Decimal(5, 2)
  test_2                  Decimal? @db.Decimal(5, 2)
  test_3                  Decimal? @db.Decimal(5, 2)
  test_4                  Decimal? @db.Decimal(5, 2)
  test_5                  Decimal? @db.Decimal(5, 2)
  test_6                  Decimal? @db.Decimal(5, 2)
  test_7                  Decimal? @db.Decimal
  test_8                  Decimal? @db.Decimal
  snapshot_stage          Int?
  tests_taken             Int?     @default(0)
  test_average            Decimal? @db.Decimal(5, 2)
  current_label           String?  @db.VarChar(20)
  previous_label          String?  @db.VarChar(20)
  benchmark_label         String?  @db.VarChar(20)
  has_label_changed       Boolean? @default(false)
  label_change_direction  String?  @db.VarChar(10)
  last_checkpoint         String?  @db.VarChar(20)
  pass_chuan_status       String?  @db.VarChar(50)
  pass_chuan_reasons      String?
  pass_mem_status         String?  @db.VarChar(50)
  pass_mem_group          String?  @db.VarChar(20)
  pass_mem_label          String?  @db.VarChar(100)
  flag_attendance_drop    Boolean? @default(false)
  flag_homework_drop      Boolean? @default(false)
  flag_cheating           Boolean? @default(false)
  flag_needs_review       Boolean? @default(false)
  teacher_feedback_btvn   String?
  teacher_feedback_orient String?
  teacher_note            String?
  teacher_temp_label      String?  @db.VarChar(20)
  scraped_at              DateTime @default(now()) @db.Timestamptz(6)
  classes                 classes  @relation(fields: [class_id], references: [class_id], onDelete: NoAction, onUpdate: NoAction)
  students                students @relation(fields: [student_id], references: [student_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([student_id, class_id, snapshot_stage], map: "uq_student_stage")
  @@index([class_id, record_date], map: "idx_student_rec_class")
  @@index([student_id, class_id, snapshot_stage], map: "idx_student_daily_stage")
  @@index([student_id, record_date(sort: Desc)], map: "idx_student_rec_date")
  @@index([current_label, record_date], map: "idx_student_rec_label")
}

