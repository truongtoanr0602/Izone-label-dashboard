/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model test_scores {
  id            BigInt   @id @default(autoincrement())
  student_id    Int
  class_id      Int
  test_order    Int
  test_name     String   @db.VarChar(30)
  raw_score     Decimal? @db.Decimal(5, 2)
  max_score     Decimal? @default(100) @db.Decimal(5, 2)
  grade_percent Decimal? @db.Decimal(5, 2)
  is_makeup     Boolean  @default(false)
  makeup_score  Decimal? @db.Decimal(5, 2)
  final_score   Decimal? @db.Decimal(5, 2)
  grade_status  String?  @default("confirmed") @db.VarChar(20)
  is_cheating   Boolean  @default(false)
  grade_note    String?
  label_at_time String?  @db.VarChar(20)
  test_at       DateTime @db.Timestamptz(6)
  scraped_at    DateTime @default(now()) @db.Timestamptz(6)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  classes       classes  @relation(fields: [class_id], references: [class_id], onDelete: NoAction, onUpdate: NoAction)
  students      students @relation(fields: [student_id], references: [student_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([student_id, class_id, test_order, is_makeup], map: "uq_test_score")
  @@index([class_id, test_order], map: "idx_test_class")
  @@index([student_id], map: "idx_test_student")
  @@index([student_id, class_id, test_at, test_order], map: "idx_test_scores_student_test_at")
}

model contact_logs {
  contact_id BigInt   @id @default(autoincrement())
  student_id Int
  class_id   Int
  teacher_id Int
  channel    String   @default("zalo") @db.VarChar(20)
  trigger_type String @db.VarChar(50)
  checkpoint String   @db.VarChar(20)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  classes    classes  @relation(fields: [class_id], references: [class_id], onDelete: NoAction, onUpdate: NoAction)
  students   students @relation(fields: [student_id], references: [student_id], onDelete: NoAction, onUpdate: NoAction)
  teachers   teachers @relation(fields: [teacher_id], references: [teacher_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([student_id, class_id, trigger_type, checkpoint], map: "uq_contact_log")
  @@index([class_id], map: "idx_contact_logs_class")
  @@index([student_id], map: "idx_contact_logs_student")
}

model khoi {
  khoi_id    Int       @id
  khoi_name  String    @db.VarChar(50)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  teachers   teachers[]
}
